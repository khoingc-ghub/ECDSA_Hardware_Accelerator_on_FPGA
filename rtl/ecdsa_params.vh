//=================//

localparam logic [255:0] P_K1       = 256'hFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F;

localparam logic [255:0] IP_P_K1    = 256'h00000000000000000000000000000000000000000000000000000001000003D1;

