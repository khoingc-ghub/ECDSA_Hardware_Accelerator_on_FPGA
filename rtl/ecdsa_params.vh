`ifndef ECDSA_PARAMS_SVH
`define ECDSA_PARAMS_SVH

//====================//
// Montgomery setting //
//====================//

// R = 2^260
// ONE_* = R mod modulus
// R2_*  = R^2 mod modulus = 2^520 mod modulus
// N0_*  = -modulus^(-1) mod 2^52

//=================//
// secp256r1 mod p //
//=================//

localparam logic [255:0] P_R1       = 256'hFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF;

localparam logic [255:0] IP_P_R1    = 256'h00000000FFFFFFFEFFFFFFFFFFFFFFFFFFFFFFFF000000000000000000000001;

localparam logic [255:0] ONE_P_R1   = 256'h0000000FFFFFFFEFFFFFFFFFFFFFFFFFFFFFFFF0000000000000000000000010;

